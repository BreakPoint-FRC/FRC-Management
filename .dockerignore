# Mirrors .gitignore. Every Dockerfile in this repo builds from the
# repository root (docker build -f apps/api/Dockerfile .), so this file
# applies to both -- excluding these keeps the build context small and makes
# sure the image only ever contains what `pnpm install` and the build steps
# produce inside the container, never a locally-built artifact (which may not
# even match the container's platform -- see apps/api/Dockerfile's header).

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Build output -- rebuilt inside the image, every time
dist/
**/dist/
build/
.next/
**/.next/
out/
*.tsbuildinfo

# Prisma's generated client -- regenerated by `pnpm install`'s postinstall
**/generated/

# Env files -- never bake real secrets into an image layer. Build-time public
# values (NEXT_PUBLIC_API_URL) are passed as --build-arg, not a mounted file.
.env*
*.env
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing / coverage
coverage/
playwright-report/
test-results/

# Editor / OS / VCS
.DS_Store
Thumbs.db
.vscode/
.idea/
.obsidian/
.git/
