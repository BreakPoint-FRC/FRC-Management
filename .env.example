DATABASE_URL="postgresql://breakpoint:breakpoint@localhost:5432/breakpoint"

# docker-compose.prod.yml only: the Postgres container's own credentials. Not
# read by the app itself -- api/migrate connect with DATABASE_URL, which that
# compose file builds FROM these three so the two cannot disagree (see its
# comments). Local dev and CI never read these; docker-compose.yml (no
# suffix) hardcodes the same breakpoint/breakpoint/breakpoint for its
# throwaway container instead. Change POSTGRES_PASSWORD before deploying --
# docs/deployment.md.
POSTGRES_USER="breakpoint"
POSTGRES_PASSWORD="change-me-before-deploying"
POSTGRES_DB="breakpoint"

# The Postgres *server* the integration test suite works on. Unset, the suite
# skips itself with a warning and `pnpm test` still passes on the unit suites.
#
# It is a server URL, not the database under test: the suite creates a
# throwaway database of its own beside the one named here, migrates it from
# empty, empties every table between tests, and drops it when the run ends.
# Nothing is ever written to the database in this URL, which is why it may
# point at the same local Postgres as DATABASE_URL above without putting your
# development data anywhere near a TRUNCATE.
TEST_DATABASE_URL="postgresql://breakpoint:breakpoint@localhost:5432/postgres"
# Local runs may skip when Postgres is unavailable. CI overrides this to true
# so a green pipeline proves that the integration suite actually ran.
INTEGRATION_TESTS_REQUIRED=false

API_PORT=4000
WEB_PORT=3000
# CORS: the origin the API accepts requests from. In production this is the
# public web origin (https://your-team.example) -- see docs/deployment.md.
WEB_ORIGIN="http://localhost:3000"
# docker-compose.prod.yml only: how many reverse-proxy hops to trust when
# reading X-Forwarded-For for the real client IP (what /auth/login's rate
# limit keys on). Leave at 0 (or unset) unless api sits behind exactly one
# reverse proxy that is itself the only thing that can reach it -- see
# docker-compose.prod.yml's header and docs/deployment.md. Trusting this with
# api reachable from anywhere else lets any caller pick its own rate-limit
# identity by sending its own X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Baked into the web app's client bundle at BUILD time, not read at runtime --
# see the README's PWA section and docs/deployment.md. In production this is
# the public origin a browser reaches the API at (behind your reverse proxy),
# never a Docker-internal service name like http://api:4000.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Signs the short-lived access tokens. Generate a fresh one per environment:
#   openssl rand -hex 32
# The API refuses to start without it.
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef0123456789abcdef"
# How long an access token is good for. Short by design: the refresh token is
# what keeps someone signed in, and a stolen access token expires on its own.
JWT_ACCESS_TTL="15m"
# How long a refresh token stays valid server-side without use. The client
# holds it in memory only, so a closed tab ends the session well before this.
REFRESH_TOKEN_TTL_DAYS=30

# The first platform system admin, created by:
#   pnpm --filter @breakpoint/db db:bootstrap
#
# A system admin belongs to no team and opens the teams that do. It is not
# created by a migration (that would put a known password in every deployment)
# or by the seed (that would be a file with the password in it), so it is read
# from here once and left nowhere else. Change both before deploying.
#
# Running db:bootstrap again is a RESET, not a no-op: it overwrites the
# password to whatever is here right now and revokes every live session for
# THIS admin account -- not every account on the platform; team members are
# untouched. Changing SYSTEM_ADMIN_EMAIL to a new address moves who the admin
# is: the previous address loses the role and its sessions too, so there is
# always exactly one. Run it once, by hand, after the first deploy -- never
# on every deploy. See docs/deployment.md.
#
# Must both be real values, not the placeholders below -- bootstrap refuses
# to run with either literal default.
SYSTEM_ADMIN_EMAIL="admin@breakpoint.test"
SYSTEM_ADMIN_PASSWORD="change-me-at-least-ten-chars"
