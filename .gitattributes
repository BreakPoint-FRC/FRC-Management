# Normalise line endings. Without this, Windows clones (core.autocrlf=true)
# and macOS/Linux clones produce whole-file diffs against each other.
* text=auto eol=lf

# Files that must keep CRLF on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diffed, never line-ending-converted.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated: keep it out of diffs and out of language stats.
pnpm-lock.yaml linguist-generated=true -diff
