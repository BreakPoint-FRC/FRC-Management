{
  "name": "@breakpoint/api",
  "private": true,
  "version": "0.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@breakpoint/db": "workspace:*",
    "@breakpoint/types": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@breakpoint/config": "workspace:*",
    "@types/node": "^20.14.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
