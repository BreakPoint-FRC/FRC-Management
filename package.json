{
  "name": "breakpoint",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:libs": "pnpm --filter @breakpoint/db --filter @breakpoint/types run build",
    "dev": "pnpm run build:libs && pnpm -r --if-present --parallel run dev",
    "dev:api": "pnpm run build:libs && pnpm --filter @breakpoint/api dev",
    "dev:web": "pnpm run build:libs && pnpm --filter @breakpoint/web dev",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm run build:libs && pnpm -r --if-present run typecheck",
    "test": "pnpm run build:libs && pnpm -r --if-present run test",
    "db:generate": "pnpm -r --if-present run db:generate"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
